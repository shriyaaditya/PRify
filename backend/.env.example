# PRify Environment Variables Template
# Copy this file to .env and fill in real values before running local or production servers.

# --- Core App Settings ---
PROJECT_NAME="PRify"
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/prify"
JWT_SECRET="generate-a-secure-random-secret-key-here"

# --- OpenAI Models & API Key ---
OPENAI_API_KEY="sk-..."

# --- Vector Storage (Qdrant) ---
QDRANT_URL="http://localhost:6333"
QDRANT_API_KEY=""

# --- GitHub App & Webhook Configuration ---
GITHUB_APP_ID="123456"
GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
GITHUB_WEBHOOK_SECRET="your-webhook-secret"
GITHUB_CLIENT_ID="Iv1..."
GITHUB_CLIENT_SECRET="0123..."

# --- Static Analysis (Semgrep) ---
SEMGREP_RULES="p/security-audit"
SEMGREP_TIMEOUT_SECONDS=30
